// package.json
{
  "name": "ipl-auction-battle",
  "version": "1.0.0",
  "description": "IPL Auction Battle - Multiplayer Cricket Auction Game",
  "private": true,
  "scripts": {
    "dev:server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build": "tsc -p tsconfig.server.json && npm run build:client",
    "start": "node dist/server/index.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
